{
  "entries": [
    {
      "id": "enclosure.shell.rounded_box",
      "name": "Rounded Box Shell Enclosure",
      "functions": ["Enclosure", "Housing", "ProtectiveShell"],
      "parameters": {
        "width": { "type": "length", "minimum": 15.0, "maximum": 350.0, "default": 80.0 },
        "depth": { "type": "length", "minimum": 15.0, "maximum": 350.0, "default": 60.0 },
        "height": { "type": "length", "minimum": 10.0, "maximum": 300.0, "default": 40.0 },
        "wallThickness": { "type": "length", "minimum": 1.2, "maximum": 12.0, "default": 2.4 },
        "filletRadius": { "type": "length", "minimum": 0.5, "maximum": 20.0, "default": 4.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["planar_mount", "lid_seam"],
      "generator": "sdf_rounded_box_shell",
      "snippetTemplate": "float3 p = pos - float3(0.0f, 0.0f, height * 0.5f); float3 b = float3(width * 0.5f - filletRadius, depth * 0.5f - filletRadius, height * 0.5f - filletRadius); float3 q = fabs(p) - b; float outer = length(fmax(q, 0.0f)) + fmin(fmax(q.x, fmax(q.y, q.z)), 0.0f) - filletRadius; return fabs(outer + wallThickness * 0.5f) - wallThickness * 0.5f;"
    },
    {
      "id": "enclosure.shell.cylindrical",
      "name": "Cylindrical Shell Enclosure",
      "functions": ["Enclosure", "Housing", "ProtectiveShell"],
      "parameters": {
        "radius": { "type": "length", "minimum": 8.0, "maximum": 180.0, "default": 35.0 },
        "height": { "type": "length", "minimum": 10.0, "maximum": 300.0, "default": 60.0 },
        "wallThickness": { "type": "length", "minimum": 1.2, "maximum": 12.0, "default": 2.4 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["circular_spigot", "axial_thread"],
      "generator": "sdf_cylindrical_shell",
      "snippetTemplate": "float r = length(pos.xy) - radius; float z = fabs(pos.z - height * 0.5f) - height * 0.5f; float outer = length(fmax(float2(r, z), 0.0f)) + fmin(fmax(r, z), 0.0f); return fabs(outer + wallThickness * 0.5f) - wallThickness * 0.5f;"
    },
    {
      "id": "stand.pedestal.weighted",
      "name": "Weighted Pedestal Base",
      "functions": ["Stand", "Base", "Support"],
      "parameters": {
        "baseRadius": { "type": "length", "minimum": 20.0, "maximum": 180.0, "default": 55.0 },
        "topRadius": { "type": "length", "minimum": 10.0, "maximum": 100.0, "default": 25.0 },
        "height": { "type": "length", "minimum": 8.0, "maximum": 150.0, "default": 24.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["circular_spigot", "planar_mount"],
      "generator": "sdf_tapered_pedestal",
      "snippetTemplate": "float t = clamp(pos.z / height, 0.0f, 1.0f); float r = mix(baseRadius, topRadius, t); float radial = length(pos.xy) - r; float vertical = fabs(pos.z - height * 0.5f) - height * 0.5f; return fmax(radial, vertical);"
    },
    {
      "id": "stand.tripod.spread",
      "name": "Three-Leg Tripod Stand",
      "functions": ["Stand", "Base", "Support"],
      "parameters": {
        "footprintRadius": { "type": "length", "minimum": 25.0, "maximum": 200.0, "default": 70.0 },
        "legThickness": { "type": "length", "minimum": 3.0, "maximum": 25.0, "default": 8.0 },
        "height": { "type": "length", "minimum": 15.0, "maximum": 180.0, "default": 45.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLS"],
        "supportsRequired": true
      },
      "interfaces": ["circular_spigot"],
      "generator": "sdf_tripod_stand",
      "snippetTemplate": "float hub = length(pos - float3(0.0f, 0.0f, height)) - legThickness * 1.4f; return hub;"
    },
    {
      "id": "stand.clamp.desk",
      "name": "C-Clamp Desk Mount",
      "functions": ["Stand", "Mount", "Clamp"],
      "parameters": {
        "jawOpening": { "type": "length", "minimum": 10.0, "maximum": 80.0, "default": 38.0 },
        "throatDepth": { "type": "length", "minimum": 15.0, "maximum": 80.0, "default": 32.0 },
        "wallThickness": { "type": "length", "minimum": 4.0, "maximum": 20.0, "default": 7.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["planar_mount", "m3_fastener_pattern"],
      "generator": "sdf_c_clamp",
      "snippetTemplate": "return length(pos) - wallThickness;"
    },
    {
      "id": "mount.boss.m3_heatset",
      "name": "M3 Heat-Set Insert Boss",
      "functions": ["Fastening", "Mount", "Interface"],
      "parameters": {
        "outerDiameter": { "type": "length", "minimum": 7.5, "maximum": 16.0, "default": 9.0 },
        "boreDiameter": { "type": "length", "minimum": 3.8, "maximum": 4.4, "default": 4.0 },
        "depth": { "type": "length", "minimum": 5.0, "maximum": 25.0, "default": 8.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["m3_fastener_pattern"],
      "generator": "sdf_heatset_boss",
      "snippetTemplate": "float r = length(pos.xy); float outer = r - outerDiameter * 0.5f; float bore = boreDiameter * 0.5f - r; float z = fabs(pos.z - depth * 0.5f) - depth * 0.5f; return fmax(fmax(outer, bore), z);"
    },
    {
      "id": "mount.snapfit.cantilever",
      "name": "Cantilever Snap-Fit Clip",
      "functions": ["Fastening", "Latch", "Interface"],
      "parameters": {
        "beamLength": { "type": "length", "minimum": 6.0, "maximum": 40.0, "default": 14.0 },
        "beamThickness": { "type": "length", "minimum": 1.2, "maximum": 5.0, "default": 1.8 },
        "undercut": { "type": "length", "minimum": 0.6, "maximum": 3.0, "default": 1.2 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["lid_seam"],
      "generator": "sdf_cantilever_snap",
      "snippetTemplate": "return fabs(pos.x) - beamThickness * 0.5f;"
    },
    {
      "id": "core.lattice.gyroid",
      "name": "Gyroid TPMS Lightweight Core",
      "functions": ["Infill", "LightweightCore", "HeatDissipation"],
      "parameters": {
        "cellSize": { "type": "length", "minimum": 4.0, "maximum": 40.0, "default": 10.0 },
        "wallThickness": { "type": "length", "minimum": 0.8, "maximum": 6.0, "default": 1.4 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["volumetric_core"],
      "generator": "tpms_gyroid",
      "snippetTemplate": "float k = 6.2831853f / cellSize; float3 s = pos * k; float g = sin(s.x)*cos(s.y) + sin(s.y)*cos(s.z) + sin(s.z)*cos(s.x); return fabs(g) / k - wallThickness * 0.5f;"
    },
    {
      "id": "core.ribs.radial",
      "name": "Radial Structural Stiffening Ribs",
      "functions": ["Stiffener", "LightweightCore", "Support"],
      "parameters": {
        "ribCount": { "type": "count", "minimum": 3.0, "maximum": 24.0, "default": 6.0 },
        "ribThickness": { "type": "length", "minimum": 1.2, "maximum": 8.0, "default": 2.0 },
        "outerRadius": { "type": "length", "minimum": 10.0, "maximum": 180.0, "default": 40.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["circular_spigot"],
      "generator": "sdf_radial_ribs",
      "snippetTemplate": "return length(pos.xy) - outerRadius;"
    },
    {
      "id": "routing.channel.rear_slot",
      "name": "Rear Cable Routing Slot",
      "functions": ["CableRoute", "Ventilation"],
      "parameters": {
        "slotWidth": { "type": "length", "minimum": 3.0, "maximum": 30.0, "default": 8.0 },
        "slotDepth": { "type": "length", "minimum": 3.0, "maximum": 30.0, "default": 8.0 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["cable_exit"],
      "generator": "sdf_cable_slot",
      "snippetTemplate": "return fmax(fabs(pos.x) - slotWidth * 0.5f, fabs(pos.y) - slotDepth * 0.5f);"
    },
    {
      "id": "shade.diffuser.cone",
      "name": "Conical Light Diffuser Shade",
      "functions": ["Shade", "Diffuser", "Cover"],
      "parameters": {
        "bottomRadius": { "type": "length", "minimum": 20.0, "maximum": 180.0, "default": 65.0 },
        "topRadius": { "type": "length", "minimum": 10.0, "maximum": 120.0, "default": 28.0 },
        "height": { "type": "length", "minimum": 20.0, "maximum": 250.0, "default": 90.0 },
        "wallThickness": { "type": "length", "minimum": 1.2, "maximum": 6.0, "default": 1.8 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["circular_spigot"],
      "generator": "sdf_conical_shade",
      "snippetTemplate": "float t = clamp(pos.z / height, 0.0f, 1.0f); float r = mix(bottomRadius, topRadius, t); return fabs(length(pos.xy) - r) - wallThickness * 0.5f;"
    },
    {
      "id": "shade.diffuser.ribbed",
      "name": "Ribbed Cylindrical Diffuser",
      "functions": ["Shade", "Diffuser"],
      "parameters": {
        "radius": { "type": "length", "minimum": 20.0, "maximum": 160.0, "default": 50.0 },
        "height": { "type": "length", "minimum": 20.0, "maximum": 250.0, "default": 95.0 },
        "ribCount": { "type": "count", "minimum": 8.0, "maximum": 48.0, "default": 24.0 },
        "wallThickness": { "type": "length", "minimum": 1.2, "maximum": 5.0, "default": 1.8 }
      },
      "manufacturing": {
        "processes": ["FDM", "SLA", "SLS"],
        "supportsRequired": false
      },
      "interfaces": ["circular_spigot"],
      "generator": "sdf_ribbed_shade",
      "snippetTemplate": "float angle = atan2(pos.y, pos.x); float wave = 1.5f * sin(angle * ribCount); return fabs(length(pos.xy) - (radius + wave)) - wallThickness * 0.5f;"
    }
  ],
  "compatibilityRules": [
    {
      "conditions": [
        { "node": "Stand", "variant": "stand.clamp.desk" },
        { "node": "Shade", "variant": "shade.diffuser.ribbed" }
      ],
      "compatible": false,
      "rationale": "Desk C-clamp lacks a concentric spigot collar for the ribbed cylindrical diffuser"
    },
    {
      "conditions": [
        { "node": "Enclosure", "variant": "enclosure.shell.cylindrical" },
        { "node": "Fastening", "variant": "mount.snapfit.cantilever" }
      ],
      "compatible": false,
      "rationale": "Planar cantilever snap-fit requires a straight lid seam rather than a cylindrical shell"
    }
  ]
}
