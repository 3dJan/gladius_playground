          "glfw-binding",
@GLADIUS_VCPKG_IMGUI_RENDERER_FEATURE@
          "win32-binding",
          "test-engine"
        ]
    },
    {
        "name": "imgui",
        "platform": "!windows",
        "features":
        [
          "docking-experimental",
          "glfw-binding",
@GLADIUS_VCPKG_IMGUI_RENDERER_FEATURE@
          "test-engine"
        ]
    },
    "imgui-node-editor",
    "cmakerc",
    "blosc",
    "zlib",
    "lodepng",
    "minizip",
