{
    "configurePresets": [
        {
            "name": "windows-base",
            "description": "Target Windows with the Visual Studio development environment.",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "$env{CML}/gladius/gladius-1.2.15",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "ENABLE_UI_TESTING": "$env{GLADIUS_ENABLE_UI_TESTING}",
                "CMAKE_TOOLCHAIN_FILE": {
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                    "type": "FILEPATH"
                },
                "USE_CACHE": "true",
                "ENABLE_ASAN": "false",
                "VCPKG_TARGET_TRIPLET": "x64-windows-gladius",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlay-ports",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "environment": {
                "CMAKE_BUILD_PARALLEL_LEVEL": "8"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (Debug)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "/Z7 /RTCus /D_ITERATOR_DEBUG_LEVEL=2 /D_DEBUG /D_DISABLE_VECTOR_ANNOTATION",
                "ENABLE_TRACY": "false",
                "ENABLE_ASAN": "false",
                "ENABLE_OPENCL_TESTS": "ON"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (RelWithDebInfo)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TRACY": "false",
                "ENABLE_OPENCL_TESTS": "ON"
            }
        },
        {
            "name": "x64-release-debug",
            "displayName": "x64 Release with Debug",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (RelWithDebInfo)",
            "inherits": "x64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_DEBUG": "/Z7",
                "ENABLE_TRACY": "false",
                "ENABLE_ASAN": "false"
            }
        },
        {
            "name": "x64-release-debug-asan",
            "displayName": "x64 Release with Debug and ASAN",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (RelWithDebInfo)",
            "inherits": "x64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_TRACY": "false",
                "ENABLE_ASAN": "true",
                "VCPKG_TARGET_TRIPLET": "x64-windows-asan"
            }
        },
        {
            "name": "x64-release-debug-noOpenCL",
            "displayName": "x64 Release with Debug (No OpenCL Tests)",
            "description": "Target Windows (64-bit) with OpenCL tests disabled. (RelWithDebInfo)",
            "inherits": "x64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_DEBUG": "/Z7",
                "ENABLE_TRACY": "false",
                "ENABLE_ASAN": "false",
                "ENABLE_OPENCL_TESTS": "OFF"
            }
        },
        {
            "name": "linux-base",
            "displayName": "Default Clang",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "ENABLE_UI_TESTING": "$env{GLADIUS_ENABLE_UI_TESTING}",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "USE_CACHE": "true",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlay-ports",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_TRACY": "TRUE",
                "GLADIUS_ENABLE_WEBGPU": "ON"
            },
            "environment": {
                "CMAKE_BUILD_PARALLEL_LEVEL": "8"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-releaseWithDebug",
            "description": "",
            "displayName": "",
            "inherits": [
                "linux-release"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux-releaseWithDebug-noOpenCL",
            "description": "Linux RelWithDebInfo build with OpenCL tests disabled",
            "displayName": "Linux RelWithDebInfo (No OpenCL Tests)",
            "inherits": [
                "linux-release"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_OPENCL_TESTS": "OFF"
            }
        },
        {
            "name": "linux-webgpu-releaseWithDebug",
            "description": "Linux RelWithDebInfo pure WebGPU configuration",
            "displayName": "Linux RelWithDebInfo (WebGPU only)",
            "inherits": [
                "linux-release"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "GLADIUS_ENABLE_OPENCL": "OFF",
                "GLADIUS_ENABLE_WEBGPU": "ON",
                "GLADIUS_UI_BACKEND": "WEBGPU",
                "ENABLE_OPENCL_TESTS": "OFF"
            }
        }
    ],
    "version": 3,
    "buildPresets": [
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "configurePreset": "x64-debug",
            "jobs": 2
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "configurePreset": "x64-release",
            "jobs": 2
        },
        {
            "name": "x64-release-debug",
            "displayName": "x64 Release with Debug",
            "configurePreset": "x64-release-debug",
            "jobs": 2
        },
        {
            "name": "x64-release-debug-asan",
            "displayName": "x64 Release with Debug and ASAN",
            "configurePreset": "x64-release-debug-asan",
            "jobs": 2
        },
        {
            "name": "x64-release-debug-noOpenCL",
            "displayName": "x64 Release with Debug (No OpenCL Tests)",
            "configurePreset": "x64-release-debug-noOpenCL",
            "jobs": 2
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "jobs": 8
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "jobs": 8
        },
        {
            "name": "linux-releaseWithDebug",
            "configurePreset": "linux-releaseWithDebug",
            "jobs": 8
        },
        {
            "name": "linux-releaseWithDebug-noOpenCL",
            "configurePreset": "linux-releaseWithDebug-noOpenCL",
            "jobs": 8
        },
        {
            "name": "linux-webgpu-releaseWithDebug",
            "displayName": "Linux RelWithDebInfo (WebGPU only)",
            "configurePreset": "linux-webgpu-releaseWithDebug",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "ReleaseWithDebug",
            "description": "",
            "displayName": "",
            "configurePreset": "linux-releaseWithDebug",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug/ctest-ReleaseWithDebug.log"
            }
        },
        {
            "name": "ReleaseWithDebug-noOpenCL",
            "description": "Tests without OpenCL requirements",
            "displayName": "RelWithDebInfo Tests (No OpenCL)",
            "configurePreset": "linux-releaseWithDebug-noOpenCL",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug-noOpenCL/ctest-ReleaseWithDebug-noOpenCL.log"
            }
        },
        {
            "name": "UnitTests",
            "description": "Fast unit tests only (<60s, no GPU required)",
            "displayName": "Unit Tests",
            "configurePreset": "linux-releaseWithDebug",
            "filter": {
                "include": {
                    "label": "unit"
                }
            },
            "output": {
                "outputOnFailure": true,
                "verbosity": "default",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug/ctest-UnitTests.log"
            }
        },
        {
            "name": "IntegrationTests",
            "description": "Integration tests (GPU tests, longer running)",
            "displayName": "Integration Tests",
            "configurePreset": "linux-releaseWithDebug",
            "filter": {
                "include": {
                    "label": "integration"
                }
            },
            "environment": {
                "GLADIUS_RUN_GPU_TESTS": "1"
            },
            "output": {
                "outputOnFailure": true,
                "verbosity": "default",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug/ctest-IntegrationTests.log"
            }
        },
        {
            "name": "ApiTests",
            "description": "API tests (MCP, external interfaces)",
            "displayName": "API Tests",
            "configurePreset": "linux-releaseWithDebug",
            "filter": {
                "include": {
                    "label": "api"
                }
            },
            "output": {
                "outputOnFailure": true,
                "verbosity": "default",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug/ctest-ApiTests.log"
            }
        },
        {
            "name": "AllTests",
            "description": "Run all tests (unit, integration, api)",
            "displayName": "All Tests",
            "configurePreset": "linux-releaseWithDebug",
            "environment": {
                "GLADIUS_RUN_GPU_TESTS": "1"
            },
            "output": {
                "outputOnFailure": true,
                "verbosity": "default",
                "outputLogFile": "${sourceDir}/out/build/linux-releaseWithDebug/ctest-AllTests.log"
            }
        }
    ]
}